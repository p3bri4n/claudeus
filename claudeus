#!/bin/bash
# Lance Claude Code en mode autonome dans un conteneur isolé, sans VS Code.
#
# Usage :
#   claudeus [--profile <nom>] <path> [yolo|claude|shell|<commande>]
#   claudeus [--profile <nom>] [yolo|claude|shell|<commande>]  # répertoire courant
#   claudeus [--profile <nom>] <path> selftest   # auto-contrôle de l'isolation (code 1 au premier échec)
#
# Profils d'identité : --profile <nom> charge ~/.config/claudeus/<nom>.env
# (sinon : <projet>/.claudeus/profile, un nom sur une seule ligne ; sinon
# ~/.config/claudeus/env comme avant). Un profil a son propre volume de config
# Claude (claudeus-config-<nom>) : les identifiants Claude d'un profil ne sont
# pas visibles depuis un autre.
#
# Exemples :
#   claudeus ~/projets/mon-projet            # Claude en --dangerously-skip-permissions (défaut)
#   claudeus ~/projets/mon-projet yolo       # idem, explicite
#   claudeus ~/projets/mon-projet claude     # Claude en mode normal (avec prompts)
#   claudeus ~/projets/mon-projet shell      # shell bash dans le conteneur
#   cd ~/projets/mon-projet && claudeus      # depuis l'intérieur du projet
#
# Premier lancement : build de l'image (~2-3 min), puis authentification
# Claude (persistée dans le volume claudeus-config).
#
# Accès GitHub (optionnel) : crée ~/.config/claudeus/env (ou <profil>.env) contenant
#   export GH_TOKEN="github_pat_XXXX"        # PAT fine-grained, ou classique « repo » si
#                                            # le compte n'est que collaborateur (voir README)
#   export GIT_USER_NAME="Ton Nom"
#   export GIT_USER_EMAIL="ton@email.fr"
# (chmod 600). Le script le source automatiquement s'il existe.
set -euo pipefail

# Résolution robuste même invoqué via un symlink dans le PATH (ex. ~/.local/bin/claudeus)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
IMAGE_NAME="claudeus"

CONFIG_DIR="${CLAUDEUS_CONFIG_DIR:-$HOME/.config/claudeus}"

# Option --profile <nom> (avant le chemin du projet)
PROFILE=""
if [ "${1:-}" = "--profile" ]; then
    [ $# -ge 2 ] || { echo "ERREUR : --profile demande un nom" >&2; exit 2; }
    PROFILE="$2"
    shift 2
fi

# Premier argument = chemin du projet si c'est un répertoire existant ;
# sinon on retombe sur le répertoire courant (rétrocompatible avec
# `claudeus yolo` lancé depuis l'intérieur du projet).
if [ $# -gt 0 ] && [ -d "$1" ]; then
    PROJECT_DIR="$(cd "$1" && pwd)"
    shift
else
    PROJECT_DIR="$(pwd)"
fi
PROJECT_NAME="$(basename "$PROJECT_DIR")"

# Profil : --profile > <projet>/.claudeus/profile > aucun (fichier « env »).
# Le fichier du projet est lisible par l'agent : il ne sert qu'à choisir un nom
# (validé ci-dessous), jamais un chemin.
if [ -z "$PROFILE" ] && [ -f "$PROJECT_DIR/.claudeus/profile" ]; then
    PROFILE="$(head -n 1 "$PROJECT_DIR/.claudeus/profile" | tr -d '[:space:]')"
fi
if [ -n "$PROFILE" ] && ! [[ "$PROFILE" =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "ERREUR : nom de profil invalide (autorisé : lettres, chiffres, _ et -)" >&2
    exit 2
fi

# Charger la config GitHub/Git. Avec un profil, on part d'un environnement vide
# pour ne jamais hériter d'un GH_TOKEN ou d'une identité du shell appelant.
if [ -n "$PROFILE" ]; then
    ENV_FILE="$CONFIG_DIR/$PROFILE.env"
    if [ ! -f "$ENV_FILE" ]; then
        echo "ERREUR : profil « $PROFILE » introuvable : $ENV_FILE" >&2
        exit 2
    fi
    unset GH_TOKEN GIT_USER_NAME GIT_USER_EMAIL
    CONFIG_VOLUME="claudeus-config-$PROFILE"
else
    ENV_FILE="$CONFIG_DIR/env"
    CONFIG_VOLUME="claudeus-config"
fi
[ -f "$ENV_FILE" ] && source "$ENV_FILE"

# Identifiants qui ne doivent JAMAIS atteindre le conteneur, quoi qu'ait
# exporté le shell appelant ou le fichier d'env. (Seules les variables listées
# par -e plus bas sont transmises ; on les retire quand même explicitement.)
unset GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN SSH_AUTH_SOCK

# Alias vers les noms de variables attendus dans le conteneur. Nécessaire pour
# pouvoir utiliser `docker run -e VAR` (sans "=valeur") plus bas : cette forme
# lit la valeur depuis l'environnement du process docker et la transmet au
# conteneur via le socket, sans jamais l'écrire dans les argv de `docker run`
# — sinon visible en clair par n'importe qui sur la machine via `ps aux`.
export GIT_AUTHOR_NAME="${GIT_USER_NAME:-}"
export GIT_AUTHOR_EMAIL="${GIT_USER_EMAIL:-}"
export GIT_COMMITTER_NAME="${GIT_USER_NAME:-}"
export GIT_COMMITTER_EMAIL="${GIT_USER_EMAIL:-}"

# Whitelist réseau : celle de Claudeus, éventuellement fusionnée avec
# <projet>/.claudeus/URL_whitelist.yml. La fusion se fait ICI, sur l'hôte : le
# fichier du projet est dans /workspace, modifiable par l'agent. Le résultat est
# un fichier temporaire monté en lecture seule dans le conteneur, donc
# impossible à élargir depuis l'intérieur (même en relançant init-firewall.sh).
BASE_WHITELIST="$SCRIPT_DIR/.devcontainer/URL_whitelist.yml"
PROJECT_WHITELIST="$PROJECT_DIR/.claudeus/URL_whitelist.yml"
WHITELIST_MOUNT="$BASE_WHITELIST"
MERGED_WHITELIST=""
cleanup() {
    [ -n "$MERGED_WHITELIST" ] && rm -f "$MERGED_WHITELIST"
    [ -n "${EMPTY_DIR:-}" ] && rmdir "$EMPTY_DIR" 2>/dev/null
    return 0
}
trap cleanup EXIT

# Liste les entrées d'une clé (domains | optional_domains) d'un fichier YAML plat.
yaml_list() {
    awk -v key="$1" '
        $0 ~ "^"key":" { flag=1; next }
        /^[^ \t#]/ { flag=0 }
        flag && /^[ \t]*-/ { print }
    ' "$2" | sed -E 's/^[[:space:]]*-[[:space:]]*//; s/[[:space:]]*#.*$//; s/^"(.*)"$/\1/' | grep -v '^[[:space:]]*$' || true
}

if [ -f "$PROJECT_WHITELIST" ]; then
    # Seules les clés domains / optional_domains sont comprises ; le reste est refusé
    # plutôt qu'ignoré en silence.
    if bad=$(grep -E '^[^ \t#-]' "$PROJECT_WHITELIST" | grep -vE '^(domains|optional_domains):[[:space:]]*(#.*)?$'); then
        echo "ERREUR : clé inconnue dans $PROJECT_WHITELIST (seules domains: et optional_domains: sont permises) :" >&2
        echo "$bad" >&2
        exit 2
    fi
    MERGED_WHITELIST="$(mktemp "${TMPDIR:-/tmp}/claudeus-whitelist.XXXXXX")"
    chmod 0644 "$MERGED_WHITELIST"   # lisible par l'utilisateur du conteneur ; monté :ro
    HOSTNAME_RE='^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$'
    declare -A SEEN_REQUIRED=()
    {
        echo "# Fichier généré par claudeus (fusion de la whitelist de base et de celle du projet)."
        echo "domains:"
        for f in "$BASE_WHITELIST" "$PROJECT_WHITELIST"; do
            while IFS= read -r d; do
                [[ "$d" =~ $HOSTNAME_RE ]] || { echo "ERREUR : domaine invalide « $d » dans $f" >&2; exit 2; }
                [ -n "${SEEN_REQUIRED[$d]:-}" ] && continue
                SEEN_REQUIRED[$d]=1
                echo "  - $d"
            done < <(yaml_list domains "$f")
        done
        echo
        echo "optional_domains:"
        declare -A SEEN_OPTIONAL=()
        for f in "$BASE_WHITELIST" "$PROJECT_WHITELIST"; do
            while IFS= read -r d; do
                [[ "$d" =~ $HOSTNAME_RE ]] || { echo "ERREUR : domaine invalide « $d » dans $f" >&2; exit 2; }
                # Un domaine requis n'est pas répété comme optionnel (le requis l'emporte)
                [ -n "${SEEN_REQUIRED[$d]:-}" ] && continue
                [ -n "${SEEN_OPTIONAL[$d]:-}" ] && continue
                SEEN_OPTIONAL[$d]=1
                echo "  - $d"
            done < <(yaml_list optional_domains "$f")
        done
    } > "$MERGED_WHITELIST" || { echo "ERREUR : fusion de la whitelist échouée" >&2; exit 2; }
    WHITELIST_MOUNT="$MERGED_WHITELIST"
    echo ">> Whitelist : base + $PROJECT_WHITELIST ($(grep -c '^  - ' "$MERGED_WHITELIST") entrées)"
fi

# Chemins protégés dans /workspace, déclarés dans <projet>/.claudeus/ :
#   readonly-paths : montés :ro par-dessus /workspace
#   hidden-paths   : masqués (fichier -> /dev/null en :ro ; dossier -> dossier vide :ro)
# .claudeus/ lui-même est toujours monté :ro (s'il existe). Tout est résolu ICI,
# sur l'hôte. Un chemin doit être relatif, sans « .. », sans lien symbolique dans
# sa chaîne (un lien créé par l'agent ne doit pas pouvoir exposer un chemin de
# l'hôte), et sans caractères qui casseraient la syntaxe de -v.
PROTECT_ARGS=()
RO_PATHS=""
HIDDEN_PATHS=""
EMPTY_DIR=""
PROJECT_REAL="$(cd "$PROJECT_DIR" && pwd -P)"

# Affiche, un par ligne, les chemins validés d'un fichier de liste. Refuse (exit 2)
# les chemins invalides ; avertit et ignore ceux qui n'existent pas.
PATH_RE='^[A-Za-z0-9._@+/ -]+$'
validated_paths() {
    local file="$1" line rel real
    [ -f "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
        [ -n "$line" ] || continue
        if [[ "$line" == /* ]]; then
            echo "ERREUR : chemin absolu refusé dans $file : $line" >&2; exit 2
        fi
        if [[ "/$line/" == *"/../"* ]]; then
            echo "ERREUR : « .. » refusé dans $file : $line" >&2; exit 2
        fi
        if ! [[ "$line" =~ $PATH_RE ]]; then
            echo "ERREUR : caractères non permis dans $file : $line" >&2; exit 2
        fi
        rel="$(printf '%s' "$line" | sed -E 's#(^|/)\./#\1#g; s#/+#/#g; s#/$##')"
        [ -n "$rel" ] && [ "$rel" != "." ] || { echo "ERREUR : chemin vide ou « . » dans $file" >&2; exit 2; }
        if [ ! -e "$PROJECT_REAL/$rel" ] && [ ! -L "$PROJECT_REAL/$rel" ]; then
            echo "AVERTISSEMENT : $rel (dans $file) n'existe pas, ignoré" >&2; continue
        fi
        real="$(realpath -e -- "$PROJECT_REAL/$rel")"
        if [ "$real" != "$PROJECT_REAL/$rel" ]; then
            echo "ERREUR : $rel (dans $file) passe par un lien symbolique ou sort du projet : refusé" >&2; exit 2
        fi
        printf '%s\n' "$rel"
    done < "$file"
}

if [ -d "$PROJECT_REAL/.claudeus" ] && [ ! -L "$PROJECT_REAL/.claudeus" ]; then
    PROTECT_ARGS+=(-v "$PROJECT_REAL/.claudeus":/workspace/.claudeus:ro)
elif [ -L "$PROJECT_REAL/.claudeus" ]; then
    echo "ERREUR : .claudeus est un lien symbolique : refusé" >&2; exit 2
fi
if [ -f "$PROJECT_REAL/.claudeus/readonly-paths" ]; then
    # Affectation (et non process substitution) : un « exit 2 » de validated_paths
    # doit arrêter le script, pas seulement un sous-shell.
    RO_PATHS="$(validated_paths "$PROJECT_REAL/.claudeus/readonly-paths")"
    while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        PROTECT_ARGS+=(-v "$PROJECT_REAL/$rel":"/workspace/$rel":ro)
    done <<< "$RO_PATHS"
fi
if [ -f "$PROJECT_REAL/.claudeus/hidden-paths" ]; then
    HIDDEN_PATHS="$(validated_paths "$PROJECT_REAL/.claudeus/hidden-paths")"
    while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        if [ -d "$PROJECT_REAL/$rel" ]; then
            # Pas de --tmpfs : sous sysbox il est monté AVANT le bind de /workspace
            # et se retrouve masqué (vérifié). Un dossier vide de l'hôte en :ro marche.
            if [ -z "$EMPTY_DIR" ]; then
                EMPTY_DIR="$(mktemp -d "${TMPDIR:-/tmp}/claudeus-empty.XXXXXX")"
                chmod 0555 "$EMPTY_DIR"
            fi
            PROTECT_ARGS+=(-v "$EMPTY_DIR":"/workspace/$rel":ro)
        else
            PROTECT_ARGS+=(-v /dev/null:"/workspace/$rel":ro)
        fi
    done <<< "$HIDDEN_PATHS"
fi

# Build de l'image si absente
if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
    echo ">> Build de l'image $IMAGE_NAME..."
    BUILD_ARGS=()
    [ -n "${CLAUDE_CODE_VERSION:-}" ] && BUILD_ARGS+=(--build-arg "CLAUDE_CODE_VERSION=$CLAUDE_CODE_VERSION")
    [ -n "${MISE_VERSION:-}" ] && BUILD_ARGS+=(--build-arg "MISE_VERSION=$MISE_VERSION")
    docker build "${BUILD_ARGS[@]}" -t "$IMAGE_NAME" "$SCRIPT_DIR/.devcontainer"
fi

SELFTEST_ARGS=()
# Commande à exécuter dans le conteneur — yolo par défaut si rien n'est précisé
if [ "${1:-}" = "yolo" ] || [ $# -eq 0 ]; then
    CMD=(claude --dangerously-skip-permissions)
elif [ "${1:-}" = "selftest" ]; then
    # Le script d'essai est monté en :ro depuis l'hôte (pas de rebuild d'image).
    CMD=(bash /usr/local/bin/claudeus-selftest.sh)
    SELFTEST_ARGS=(
        -v "$SCRIPT_DIR/.devcontainer/selftest.sh":/usr/local/bin/claudeus-selftest.sh:ro
        -e CLAUDEUS_SELFTEST_RO="${RO_PATHS:-}"
        -e CLAUDEUS_SELFTEST_HIDDEN="${HIDDEN_PATHS:-}"
    )
elif [ "${1:-}" = "shell" ]; then
    CMD=(bash)
else
    CMD=("$@")
fi

# -t seulement si stdin est un terminal (permet l'usage non interactif : CI, selftest)
TTY_ARGS=()
[ -t 0 ] && TTY_ARGS=(-t)

# --runtime=sysbox-runc : isolation utilisateur complète, permet un dockerd
# interne (Docker-in-Docker) sans --privileged et sans cap-add (sysbox donne
# déjà les capacités nécessaires à root dans son user-namespace).
# Volume nommé pour ~/.claude : auth persistée entre les sessions
# Volume nommé pour /var/lib/docker : images/layers du DinD persistées
# Seul le dossier projet courant est monté — rien d'autre de l'hôte
docker run -i "${TTY_ARGS[@]}" --rm \
    --name "claudeus-${PROFILE:+$PROFILE-}${PROJECT_NAME}-$$" \
    --runtime=sysbox-runc \
    -v "$PROJECT_DIR":/workspace \
    "${PROTECT_ARGS[@]}" \
    "${SELFTEST_ARGS[@]}" \
    -v "$CONFIG_VOLUME":/home/node/.claude \
    -v claudeus-history:/commandhistory \
    -v claudeus-dind:/var/lib/docker \
    -v "$WHITELIST_MOUNT":/usr/local/etc/url-whitelist.yml:ro \
    -e CLAUDE_CONFIG_DIR=/home/node/.claude \
    -e GH_TOKEN \
    -e GIT_AUTHOR_NAME \
    -e GIT_AUTHOR_EMAIL \
    -e GIT_COMMITTER_NAME \
    -e GIT_COMMITTER_EMAIL \
    -w /workspace \
    "$IMAGE_NAME" \
    bash -c '
        sudo /usr/local/bin/init-firewall.sh
        sudo dockerd >/tmp/dockerd.log 2>&1 &
        for i in $(seq 1 30); do
            [ -S /var/run/docker.sock ] && break
            sleep 0.5
        done
        if [ ! -S /var/run/docker.sock ]; then
            echo "ERREUR : dockerd interne non démarré, voir /tmp/dockerd.log" >&2
            exit 1
        fi
        sudo /usr/local/bin/init-firewall-dind.sh
        # Remotes SSH -> HTTPS, en config GLOBALE du conteneur (~/.gitconfig du
        # conteneur) : le .git/config du dépôt monté reste intact. Le conteneur
        # ne contient pas de clé SSH ; seul le jeton (via gh) authentifie.
        git config --global url."https://github.com/".insteadOf git@github.com:
        git config --global --add url."https://github.com/".insteadOf ssh://git@github.com/
        { [ -n "${GH_TOKEN:-}" ] && gh auth setup-git 2>/dev/null || true; }
        exec "$@"
    ' -- "${CMD[@]}"
