#!/bin/bash
# Lance Claude Code en mode autonome dans un conteneur isolé, sans VS Code.
#
# Usage :
#   claudeus <path> [yolo|claude|shell|<commande>]
#   claudeus [yolo|claude|shell|<commande>]  # utilise le répertoire courant
#
# Exemples :
#   claudeus ~/projets/mon-projet            # Claude en --dangerously-skip-permissions (défaut)
#   claudeus ~/projets/mon-projet yolo       # idem, explicite
#   claudeus ~/projets/mon-projet claude     # Claude en mode normal (avec prompts)
#   claudeus ~/projets/mon-projet shell      # shell bash dans le conteneur
#   cd ~/projets/mon-projet && claudeus      # depuis l'intérieur du projet
#
# Premier lancement : build de l'image (~2-3 min), puis authentification
# Claude (persistée dans le volume claudeus-config).
#
# Accès GitHub (optionnel) : crée ~/.config/claudeus/env contenant
#   export GH_TOKEN="github_pat_XXXX"        # fine-grained PAT scopé aux repos utiles
#   export GIT_USER_NAME="Ton Nom"
#   export GIT_USER_EMAIL="ton@email.fr"
# (chmod 600). Le script le source automatiquement s'il existe.
set -euo pipefail

# Charger la config GitHub si présente
ENV_FILE="$HOME/.config/claudeus/env"
[ -f "$ENV_FILE" ] && source "$ENV_FILE"

# Résolution robuste même invoqué via un symlink dans le PATH (ex. ~/.local/bin/claudeus)
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
IMAGE_NAME="claudeus"

# Alias vers les noms de variables attendus dans le conteneur. Nécessaire pour
# pouvoir utiliser `docker run -e VAR` (sans "=valeur") plus bas : cette forme
# lit la valeur depuis l'environnement du process docker et la transmet au
# conteneur via le socket, sans jamais l'écrire dans les argv de `docker run`
# — sinon visible en clair par n'importe qui sur la machine via `ps aux`.
export GIT_AUTHOR_NAME="${GIT_USER_NAME:-}"
export GIT_AUTHOR_EMAIL="${GIT_USER_EMAIL:-}"
export GIT_COMMITTER_NAME="${GIT_USER_NAME:-}"
export GIT_COMMITTER_EMAIL="${GIT_USER_EMAIL:-}"

# Premier argument = chemin du projet si c'est un répertoire existant ;
# sinon on retombe sur le répertoire courant (rétrocompatible avec
# `claudeus yolo` lancé depuis l'intérieur du projet).
if [ $# -gt 0 ] && [ -d "$1" ]; then
    PROJECT_DIR="$(cd "$1" && pwd)"
    shift
else
    PROJECT_DIR="$(pwd)"
fi
PROJECT_NAME="$(basename "$PROJECT_DIR")"

# Build de l'image si absente
if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
    echo ">> Build de l'image $IMAGE_NAME..."
    docker build -t "$IMAGE_NAME" "$SCRIPT_DIR/.devcontainer"
fi

# Commande à exécuter dans le conteneur — yolo par défaut si rien n'est précisé
if [ "${1:-}" = "yolo" ] || [ $# -eq 0 ]; then
    CMD=(claude --dangerously-skip-permissions)
elif [ "${1:-}" = "shell" ]; then
    CMD=(bash)
else
    CMD=("$@")
fi

# --runtime=sysbox-runc : isolation utilisateur complète, permet un dockerd
# interne (Docker-in-Docker) sans --privileged et sans cap-add (sysbox donne
# déjà les capacités nécessaires à root dans son user-namespace).
# Volume nommé pour ~/.claude : auth persistée entre les sessions
# Volume nommé pour /var/lib/docker : images/layers du DinD persistées
# Seul le dossier projet courant est monté — rien d'autre de l'hôte
docker run -it --rm \
    --name "claudeus-${PROJECT_NAME}-$$" \
    --runtime=sysbox-runc \
    -v "$PROJECT_DIR":/workspace \
    -v claudeus-config:/home/node/.claude \
    -v claudeus-history:/commandhistory \
    -v claudeus-dind:/var/lib/docker \
    -v "$SCRIPT_DIR/.devcontainer/URL_whitelist.yml":/usr/local/etc/url-whitelist.yml:ro \
    -e CLAUDE_CONFIG_DIR=/home/node/.claude \
    -e GH_TOKEN \
    -e GIT_AUTHOR_NAME \
    -e GIT_AUTHOR_EMAIL \
    -e GIT_COMMITTER_NAME \
    -e GIT_COMMITTER_EMAIL \
    -w /workspace \
    "$IMAGE_NAME" \
    bash -c '
        sudo /usr/local/bin/init-firewall.sh
        sudo dockerd >/tmp/dockerd.log 2>&1 &
        for i in $(seq 1 30); do
            [ -S /var/run/docker.sock ] && break
            sleep 0.5
        done
        if [ ! -S /var/run/docker.sock ]; then
            echo "ERREUR : dockerd interne non démarré, voir /tmp/dockerd.log" >&2
            exit 1
        fi
        sudo /usr/local/bin/init-firewall-dind.sh
        { [ -n "${GH_TOKEN:-}" ] && gh auth setup-git 2>/dev/null || true; }
        exec "$@"
    ' -- "${CMD[@]}"
